{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./build",
    "rootDir": "./src",
    "types": ["jest"]
  },
  "include": ["./src"],
  "exclude": ["**/__tests__/**", "**/__mocks__/**"]
}
